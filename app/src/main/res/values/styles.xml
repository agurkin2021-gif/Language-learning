<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#087F72</item>
        <item name="android:colorControlActivated">#087F72</item>
        <item name="android:colorControlHighlight">#3300877A</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3F7F5</item>
        <item name="android:navigationBarColor">#18352F</item>
        <item name="android:windowActionModeOverlay">true</item>
